{
  "compilerOptions": {
    "experimentalDecorators": true,
    "module": "CommonJS",
    "rootDir": "./src",
    "target": "esnext",

    "verbatimModuleSyntax": false,

    "strict": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "outDir": "./dist"
  }
}
